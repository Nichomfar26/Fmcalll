<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contacts"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <ImageButton
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_person_add"
                android:background="@drawable/bg_icon_round"
                android:contentDescription="Ajouter"
                android:id="@+id/btn_add_header"/>
        </LinearLayout>

        <!-- Search bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="@color/surface3"
            app:boxStrokeColor="@color/gray_dark"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/gray">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rechercher un contact ou FM#..."
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:textSize="14sp"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tabs: Contacts | Nœuds détectés -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:tabBackground="@color/surface2"
            app:tabSelectedTextColor="@color/green_primary"
            app:tabUnselectedTextColor="@color/gray"
            app:tabIndicatorColor="@color/green_primary"
            app:tabIndicatorHeight="2dp"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mes contacts"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nœuds Mesh détectés"/>
        </com.google.android.material.tabs.TabLayout>

        <!-- Contact list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_contacts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun contact.\nScannez le réseau Mesh ou ajoutez manuellement."
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_person_add"
        app:backgroundTint="@color/green_primary"
        app:tint="@color/black"
        android:contentDescription="Ajouter un contact"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
