<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Node icon -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/node_icon_card"
        android:layout_width="46dp"
        android:layout_height="46dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/surface3"
        app:strokeColor="@color/green_dim"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="📡"
            android:textSize="22sp"
            android:gravity="center"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Info -->
    <LinearLayout
        android:id="@+id/node_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/node_icon_card"
        app:layout_constraintEnd_toStartOf="@id/btn_add_contact"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_node_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_node_mesh_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tv_node_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Add to contacts button -->
    <Button
        android:id="@+id/btn_add_contact"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="+ Ajouter"
        android:textSize="12sp"
        android:textColor="@color/green_primary"
        android:backgroundTint="@color/green_dim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/green_primary"/>

</androidx.constraintlayout.widget.ConstraintLayout>
