<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface2">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nom du contact"
        android:textColor="@color/gray"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/surface3"
        app:boxStrokeColor="@color/green_primary">

        <EditText
            android:id="@+id/et_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: Hassan Benali"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:inputType="textPersonName"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Identifiant Mesh (FM#XXXX-XXXX)"
        android:textColor="@color/gray"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/surface3"
        app:boxStrokeColor="@color/green_primary"
        app:prefixText="FM#"
        app:prefixTextColor="@color/green_primary">

        <EditText
            android:id="@+id/et_mesh_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="XXXX-XXXX"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:inputType="textCapCharacters"
            android:maxLength="9"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 La clé publique sera échangée automatiquement lors de la première connexion Mesh."
        android:textColor="@color/gray"
        android:textSize="11sp"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.4"/>

</LinearLayout>
