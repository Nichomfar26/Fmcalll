<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Réseau Mesh"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Scanner"
            android:textSize="12sp"
            android:textColor="@color/green_primary"
            android:backgroundTint="@color/green_dim"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/green_primary"/>
    </LinearLayout>

    <!-- Mesh status -->
    <TextView
        android:id="@+id/tv_mesh_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/gray"
        android:textSize="12sp"
        android:fontFamily="monospace"/>

    <!-- Scan progress -->
    <ProgressBar
        android:id="@+id/progress_scan"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/green_primary"
        android:visibility="gone"
        style="?android:attr/progressBarStyleHorizontal"/>

    <!-- Mesh map canvas -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/surface2"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <com.fmcall.serval.ui.nodes.MeshCanvasView
            android:id="@+id/mesh_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Node count -->
    <TextView
        android:id="@+id/tv_node_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/gray"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"/>

    <!-- Node list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</LinearLayout>
