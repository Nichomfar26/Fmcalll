<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Remote video (full screen) -->
    <FrameLayout
        android:id="@+id/remote_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <ImageView
            android:id="@+id/remote_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>

    <!-- Avatar fallback (when no video) -->
    <LinearLayout
        android:id="@+id/avatar_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_call_gradient">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:cardBackgroundColor="@color/green_primary"
            app:strokeColor="@color/green_dark"
            app:strokeWidth="3dp">
            <TextView
                android:id="@+id/tv_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="@color/black"
                android:textSize="44sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_peer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/tv_mesh_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green_primary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Waiting / Offline UI -->
    <LinearLayout
        android:id="@+id/waiting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@color/surface2"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/waiting_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="48sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_waiting_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_light"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"/>

        <Button
            android:id="@+id/btn_cancel_wait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annuler l'attente"
            android:backgroundTint="@color/surface4"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- Local video preview (picture-in-picture) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="90dp"
        android:layout_height="130dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/local_video_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/surface3"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Top bar: status + duration -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:alpha="0.85"/>

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Active call action buttons -->
    <LinearLayout
        android:id="@+id/active_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="48dp"
        android:paddingTop="20dp"
        android:background="@drawable/gradient_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mute -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="14dp">
            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_mic_on"
                android:background="@drawable/bg_call_action"
                android:contentDescription="Muet"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Muet" android:textColor="@color/white" android:textSize="11sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Hangup -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="14dp">
            <ImageButton
                android:id="@+id/btn_hangup"
                android:layout_width="68dp" android:layout_height="68dp"
                android:src="@drawable/ic_call_end"
                android:background="@drawable/bg_call_hangup"
                android:contentDescription="Raccrocher"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fin" android:textColor="@color/white" android:textSize="11sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Camera off -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="14dp">
            <ImageButton
                android:id="@+id/btn_camera_off"
                android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_videocam"
                android:background="@drawable/bg_call_action"
                android:contentDescription="Caméra"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Caméra" android:textColor="@color/white" android:textSize="11sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Flip camera -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="14dp">
            <ImageButton
                android:id="@+id/btn_flip_camera"
                android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_flip_camera"
                android:background="@drawable/bg_call_action"
                android:contentDescription="Retourner caméra"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Retourner" android:textColor="@color/white" android:textSize="11sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Incoming call buttons -->
    <LinearLayout
        android:id="@+id/incoming_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="48dp"
        android:paddingTop="20dp"
        android:background="@drawable/gradient_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="32dp">
            <ImageButton
                android:id="@+id/btn_reject"
                android:layout_width="72dp" android:layout_height="72dp"
                android:src="@drawable/ic_call_end"
                android:background="@drawable/bg_call_hangup"
                android:contentDescription="Refuser"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Refuser" android:textColor="@color/white" android:textSize="13sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="32dp">
            <ImageButton
                android:id="@+id/btn_answer"
                android:layout_width="72dp" android:layout_height="72dp"
                android:src="@drawable/ic_videocam"
                android:background="@drawable/bg_call_answer"
                android:contentDescription="Répondre"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Répondre" android:textColor="@color/white" android:textSize="13sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
